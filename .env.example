STRIPE_SECRET_KEY_LIVE=sk_live_YOUR_KEY_HERE
STRIPE_WEBHOOK_SECRET_LIVE=whsec_YOUR_WEBHOOK_SECRET_HERE

# Stripe Price IDs (Test Mode)
STRIPE_PRICE_ID_MONTHLY_TEST=price_1SmYnPG1pdDRlAv6q17RYNIr
