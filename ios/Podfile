# Use CDN for faster downloads
source 'https://cdn.cocoapods.org/'

# Specify the Xcode project
project 'FinTrackNew.xcodeproj'

# Note: Static linking is required for Firebase (FirebaseAnalytics has static binaries)

# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

# react-native-permissions configuration
def node_require(script)
  require Pod::Executable.execute_command('node', ['-p',
    "require.resolve(
      '#{script}',
      {paths: [process.argv[1]]},
    )", __dir__]).strip
end

node_require('react-native-permissions/scripts/setup.rb')

# Only enable the Camera permission handler
setup_permissions([
  'Camera',
])

# Camera Kit iOS configuration AND RNFB build phase fixes
post_integrate do |installer|
  installer.pods_project.targets.each do |target|
    if target.name == 'ReactNativeCameraKit'
      target.build_configurations.each do |config|
        config.build_settings['SWIFT_VERSION'] = '5.0'
      end
    end
  end
  
  # Fix for RNFB build phase warnings in main project
  # These warnings appear because the build phases don't specify output files
  # Must be done in post_integrate, after CocoaPods finishes integrating
  main_project_path = "#{installer.sandbox.root}/../FinTrackNew.xcodeproj"
  main_project = Xcodeproj::Project.open(main_project_path)
  
  main_project.targets.each do |target|
    if target.name == 'FinTrackNew'
      target.build_phases.each do |phase|
        if phase.is_a?(Xcodeproj::Project::Object::PBXShellScriptBuildPhase)
          if phase.name&.include?('[RNFB] Core Configuration')
            phase.output_paths = ["$(DERIVED_FILE_DIR)/RNFB-Core-Configuration-Done.txt"]
          elsif phase.name&.include?('[RNFB] Crashlytics Configuration')
            phase.output_paths = ["$(DERIVED_FILE_DIR)/RNFB-Crashlytics-Configuration-Done.txt"]
          end
        end
      end
    end
  end
  
  main_project.save
end

# Firebase iOS SDK v9+ REQUIRES use_frameworks for Swift headers (FirebaseAuth-Swift.h)
# Required for RNFBFirestore, RNFBFunctions - "FirebaseAuth/FirebaseAuth-Swift.h file not found"
use_frameworks! :linkage => :static
$RNFirebaseAsStaticFramework = true

# Suppress ALL warnings from third-party pods
inhibit_all_warnings!

target 'FinTrackNew' do
  # NOTE: Do NOT use use_modular_headers! globally - it causes "Redefinition of module 'react_runtime'"
  config = use_native_modules!
  
  # Firebase dependencies - modular headers required for Swift pods (Crashlytics, etc.)
  # Use per-pod :modular_headers => true to avoid "Redefinition of module 'react_runtime'"
  pod 'Firebase', :modular_headers => true
  pod 'FirebaseCore', :modular_headers => true
  pod 'FirebaseAuth', :modular_headers => true
  pod 'FirebaseFirestore', :modular_headers => true
  pod 'FirebaseFunctions', :modular_headers => true
  pod 'FirebaseCoreExtension', :modular_headers => true
  pod 'FirebaseAuthInterop', :modular_headers => true
  pod 'FirebaseAppCheckInterop', :modular_headers => true
  pod 'FirebaseFirestoreInternal', :modular_headers => true
  pod 'FirebaseMessagingInterop', :modular_headers => true
  pod 'FirebaseCoreInternal', :modular_headers => true
  pod 'RecaptchaInterop', :modular_headers => true
  pod 'GoogleUtilities', :modular_headers => true
  pod 'GTMSessionFetcher', :modular_headers => true
  # Required for FirebaseCrashlytics/FirebaseSessions Swift pods
  pod 'FirebaseInstallations', :modular_headers => true
  pod 'GoogleDataTransport', :modular_headers => true
  pod 'nanopb', :modular_headers => true

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    # Fix: FirebaseCrashlytics PrivacyInfo.xcprivacy missing with use_frameworks static
    # React Native's privacy manifest aggregation expects this path
    firebase_crashlytics_privacy = "#{installer.sandbox.root}/FirebaseCrashlytics/Crashlytics/Resources/PrivacyInfo.xcprivacy"
    if !File.exist?(firebase_crashlytics_privacy)
      require 'fileutils'
      FileUtils.mkdir_p(File.dirname(firebase_crashlytics_privacy))
      minimal_privacy = {
        'NSPrivacyTracking' => false,
        'NSPrivacyCollectedDataTypes' => [],
        'NSPrivacyAccessedAPITypes' => []
      }
      Xcodeproj::Plist.write_to_path(minimal_privacy, firebase_crashlytics_privacy)
      Pod::UI.puts "[FinTrack] Created missing FirebaseCrashlytics PrivacyInfo.xcprivacy".yellow
    end
    
    # https://github.com/facebook/react-native/blob/main/packages/react-native/scripts/react_native_pods.rb#L197-L202
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )
    
    # Fix for Xcode 26 beta compatibility
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        # Suppress ALL warnings from pods (C/ObjC/Swift)
        config.build_settings['CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER'] = 'NO'
        config.build_settings['CLANG_WARN_DOCUMENTATION_COMMENTS'] = 'NO'
        config.build_settings['GCC_WARN_INHIBIT_ALL_WARNINGS'] = 'YES'
        config.build_settings['SWIFT_SUPPRESS_WARNINGS'] = 'YES'
        config.build_settings['CLANG_WARN_DEPRECATED_OBJC_IMPLEMENTATIONS'] = 'NO'
        config.build_settings['CLANG_WARN_OBJC_IMPLICIT_RETAIN_SELF'] = 'NO'
        
        # Fix for Xcode 26 beta asset catalog issues
        config.build_settings['ASSETCATALOG_COMPILER_GENERATE_ASSET_SYMBOLS'] = 'NO'
        config.build_settings['VALIDATE_PRODUCT'] = 'NO'
        
        # Deployment target fix
        config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.1'
        
        # Fix for gRPC module map issues in Xcode 26
        config.build_settings['CLANG_ENABLE_MODULES'] = 'YES'
        config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'
        
        # Disable Swift Package Manager integration that causes issues
        config.build_settings['BUILD_LIBRARY_FOR_DISTRIBUTION'] = 'NO'
        
        # Fix for deprecated 'windows' API in iOS 15.0+
        config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
        
        # Fix for Swift stdlib warnings
        config.build_settings['ALWAYS_EMBED_SWIFT_STANDARD_LIBRARIES'] = 'NO'
      end
      
      # Specific fix for gRPC targets and React-oscompat - C++ standard library issues with Xcode 26
      # In Xcode 26, C++ headers moved from Toolchain to SDK
      if target.name.include?('gRPC') || target.name.include?('BoringSSL') || target.name.include?('abseil') || target.name == 'React-oscompat'
        target.build_configurations.each do |config|
          # Fix for 'cstdint'/'string' file not found - C++ standard library in Xcode 26
          config.build_settings['CLANG_CXX_LANGUAGE_STANDARD'] = 'c++20'
          config.build_settings['CLANG_CXX_LIBRARY'] = 'libc++'
          config.build_settings['GCC_ENABLE_CPP_EXCEPTIONS'] = 'YES'
          config.build_settings['GCC_ENABLE_CPP_RTTI'] = 'YES'
        end
      end
      
      # Fix gRPC-Core zutil.c fdopen macro conflict with iOS SDK 26
      # Patch zutil.h to prevent fdopen macro from conflicting with stdio.h
      if target.name == 'gRPC-Core'
        zutil_path = "#{installer.sandbox.root}/gRPC-Core/third_party/zlib/zutil.h"
        if File.exist?(zutil_path)
          # Use sed command to patch the file (avoids permission issues with Ruby File.write)
          sed_command = "sed -i '' 's/#.*define fdopen(fd,mode) NULL.*No fdopen.*$/\\/\\* fdopen macro removed for iOS SDK 26 \\*\\//' '#{zutil_path}'"
          system(sed_command)
          puts "[gRPC-Core] Patched zutil.h to fix fdopen macro conflict with iOS SDK 26"
        end
        
        # Create symlink for modulemap in the expected location
        grpc_dir = "#{installer.sandbox.root}/Headers/Private/grpc"
        modulemap_source = "#{installer.sandbox.root}/Target Support Files/gRPC-Core/gRPC-Core.modulemap"
        modulemap_dest = "#{grpc_dir}/gRPC-Core.modulemap"
        
        require 'fileutils'
        if File.exist?(modulemap_source) && !File.exist?(modulemap_dest)
          FileUtils.mkdir_p(grpc_dir)
          FileUtils.cp(modulemap_source, modulemap_dest)
          puts "[gRPC-Core] Copied modulemap to expected location"
        elsif File.exist?(modulemap_dest)
          puts "[gRPC-Core] Modulemap already exists at destination"
        end
      end
      
      # Fix for abseil targets - add proper header search paths
      if target.name == 'abseil'
        target.build_configurations.each do |config|
          config.build_settings['HEADER_SEARCH_PATHS'] ||= ['$(inherited)']
          config.build_settings['HEADER_SEARCH_PATHS'] << '"$(PODS_ROOT)/abseil"'
          config.build_settings['USER_HEADER_SEARCH_PATHS'] ||= ['$(inherited)']
          config.build_settings['USER_HEADER_SEARCH_PATHS'] << '"$(PODS_ROOT)/abseil"'
        end
      end
      
      # Fix for Stripe deprecated API warnings (including UITextItemInteraction Swift deprecation)
      if target.name.include?('Stripe')
        target.build_configurations.each do |config|
          config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
          config.build_settings['WARNING_CFLAGS'] ||= ['$(inherited)']
          config.build_settings['WARNING_CFLAGS'] << '-Wno-deprecated-declarations'
          config.build_settings['GCC_WARN_ABOUT_DEPRECATED_FUNCTIONS'] = 'NO'
          config.build_settings['SWIFT_SUPPRESS_WARNINGS'] = 'YES'
        end
      end
    end
    
    # Fix for "Create Symlinks to Header Folders" warnings
    installer.pods_project.targets.each do |target|
      target.build_phases.each do |build_phase|
        if build_phase.respond_to?(:name) && build_phase.name.include?('Create Symlinks')
          build_phase.output_paths = ["$(DERIVED_FILE_DIR)/#{target.name}-symlinks.txt"]
        end
      end
    end
    
    # Fix for gRPC-Core zutil "cannot specify -o" error in Xcode 26
    # This error occurs when gRPC tries to compile multiple files with single output
    installer.pods_project.targets.each do |target|
      if target.name == 'gRPC-Core'
        target.build_configurations.each do |config|
          # CRITICAL: Disable whole module optimization - main cause of "-o with multiple files"
          config.build_settings['SWIFT_COMPILATION_MODE'] = 'singlefile'
          config.build_settings['SWIFT_WHOLE_MODULE_OPTIMIZATION'] = 'NO'
          
          # Disable batch compilation which causes the "-o with multiple files" error
          config.build_settings['CLANG_ENABLE_MODULE_IMPLEMENTATION_OF'] = 'NO'
          config.build_settings['CLANG_USE_OPTIMIZATION_PROFILE'] = 'NO'
          
          # Disable Link-Time Optimization which can cause similar issues
          config.build_settings['LLVM_LTO'] = 'NO'
          
          # Force compilation to process files individually
          config.build_settings['RUN_CLANG_STATIC_ANALYZER'] = 'NO'
          
          # Additional zlib/zutil fix for Xcode 26
          config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] ||= ['$(inherited)']
          config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] << 'ZLIB_CONST=1'
        end
      end
      
      # Fix for hermes-engine build phase warning - add output paths
      if target.name == 'hermes-engine'
        target.build_phases.each do |phase|
          if phase.is_a?(Xcodeproj::Project::Object::PBXShellScriptBuildPhase)
            if phase.name&.include?('Hermes')
              phase.always_out_of_date = '1'
            end
          end
        end
      end
    end
    
    # Fix "Update to recommended settings" for Pods project
    installer.pods_project.build_configurations.each do |config|
      config.build_settings['DEAD_CODE_STRIPPING'] = 'YES'
      config.build_settings['LOCALIZATION_PREFERS_STRING_CATALOGS'] = 'YES'
    end
    
    # Fix glog set_ctr bug: void function should not return a value (Xcode 26 treats as error)
    glog_logging_h = "#{installer.sandbox.root}/glog/src/glog/logging.h"
    if File.exist?(glog_logging_h)
      system("sed -i '' 's/void set_ctr(int ctr) { return ctr_; }/void set_ctr(int ctr) { ctr_ = ctr; }/' '#{glog_logging_h}'")
      puts "[glog] Patched set_ctr in logging.h to fix void return error"
    end
    
  end
end
